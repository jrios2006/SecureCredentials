<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>

    <AssemblyTitle>SecureCredentials</AssemblyTitle>
    <Product>SecureCredentials</Product>
    <Company>jrios2006</Company>
    <Authors>Julio Ríos</Authors>
    <Description>
      Biblioteca .NET para cifrado y descifrado de documentos
      mediante AES-256-GCM con formato SecureCredentials.
    </Description>
    <Copyright>Copyright © 2026 - jrios2006</Copyright>

    <PackageId>SecureCredentials</PackageId>
    <PackageTags>security;encryption;aes-gcm;credentials</PackageTags>
    <IsPackable>true</IsPackable>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Posix.NETStandard" Version="1.0.0" />
  </ItemGroup>

</Project>
