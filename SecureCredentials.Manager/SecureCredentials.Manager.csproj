<!-- Archivo: SecureCredentials.Manager.csproj | Proyecto: SecureCredentials.Manager | Descripción: Configuración del proyecto gráfico .NET 10, metadatos de versión y recursos de publicación. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <InformationalVersion>1.0.1</InformationalVersion>
    
    <AssemblyTitle>SecureCredentials Manager</AssemblyTitle>
    <Product>SecureCredentials Manager</Product>
    <Company>jrios2006</Company>
    <Authors>Julio Ríos</Authors>
    <Description>
      Aplicación gráfica para administrar documentos
      cifrados con SecureCredentials.
    </Description>
    <Copyright>Copyright © 2026 - jrios2006</Copyright>

    <IsPackable>false</IsPackable>

    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SecureCredentials\SecureCredentials.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

</Project>
