<!-- Archivo: App.axaml | Proyecto: SecureCredentials.Manager | Descripción: Recursos globales de Avalonia. Selecciona el tema Fluent y sigue la preferencia de tema del sistema. -->
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SecureCredentials.Manager.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>